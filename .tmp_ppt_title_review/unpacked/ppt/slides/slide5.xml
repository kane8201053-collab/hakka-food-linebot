nd/><a:headEnd type="none" w="med" len="med"/><a:tailEnd type="none" w="med" len="med"/></a:lnT><a:lnB w="6350" cap="flat" cmpd="sng" algn="ctr"><a:solidFill><a:srgbClr val="BFC7D4"/></a:solidFill><a:prstDash val="solid"/><a:round/><a:headEnd type="none" w="med" len="med"/><a:tailEnd type="none" w="med" len="med"/></a:lnB><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill></a:tcPr></a:tc><a:extLst><a:ext uri="{0D108BD9-81ED-4DB2-BD59-A6C34878D82A}"><a16:rowId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" val="10002"/></a:ext></a:extLst></a:tr></a:tbl></a:graphicData></a:graphic></p:graphicFrame><p:sp><p:nvSpPr><p:cNvPr id="11" name="Text 8"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="3818652"/><a:ext cx="6464808" cy="292608"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" b="1" dirty="0"><a:solidFill><a:srgbClr val="1B2A4A"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>二、策展主軸與規劃理念(示例,請依貴公司創意調整)</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Text 9"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="4184412"/><a:ext cx="6464808" cy="429768"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0" algn="l"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>本公司以「民主的日常——看得見的議會」為全案策展主軸:議會不是遙遠的殿堂,而是與市民生活息息相關的日常。三項子概念貫穿各工作項目:</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="Text 10"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="658368" y="4687332"/><a:ext cx="6355080" cy="1005840"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>看見歷史:會史館以時間軸重整歷屆議會脈絡,凸顯地方自治精神之傳承。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>看見運作:簡介影片以「一件市民陳情案的旅程」為敘事線(示例),具象呈現議員如何質詢、審議、監督市政。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>看見未來:本屆議會區與國際交流區呈現第5屆議會之組成、願景與城市外交成果。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="Text 11"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="5766324"/><a:ext cx="6464808" cy="237744"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0" algn="l"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" i="1" dirty="0"><a:solidFill><a:srgbClr val="8A701B"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>【設計示意圖預留位置:主視覺與色彩計畫,建議置入 1 頁】</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="15" name="Text 12"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="6150372"/><a:ext cx="6464808" cy="292608"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" b="1" dirty="0"><a:solidFill><a:srgbClr val="1B2A4A"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>三、整合執行策略</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="16" name="Text 13"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="658368" y="6516132"/><a:ext cx="6355080" cy="1197864"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>單一專案經理統籌,下設策展設計、硬體工程、影像製作、手冊編印四個工作組,每週內部進度會議。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>素材一次採集、多重運用:攝影與文史素材同時供展板、影片、手冊使用,降低重工並確保一致性。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>送審前置:各階段文件送審前完成內部三級檢核,縮短往返修正時間。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>