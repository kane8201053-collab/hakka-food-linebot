x="548640" y="2148840"/><a:ext cx="6464808" cy="292608"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" b="1" dirty="0"><a:solidFill><a:srgbClr val="1B2A4A"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>一、案件背景</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="10" name="Text 8"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="2514600"/><a:ext cx="6464808" cy="1005840"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0" algn="l"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>新北市議會為新北市最高民意機關,會史館係市民、學校團體及國內外訪賓認識議會沿革與代議制度之重要窗口;簡報室則為放映議會簡介影片、辦理專題演講與課程之主要場域。隨第5屆議會就任,會史館展示內容需更新至本屆現況,簡報室既有投影設備(投影機2台、電腦1台、DVD播放機2台、擴音系統1套)已屆汰換週期。本會爰以總價新臺幣270萬元,徵求整合「會史館內容增修、簡報室設備更新、第5屆簡介影片製作、簡介手冊印製」之綜合性企劃(對應需求書壹、二及貳)。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="Text 9"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="3666744"/><a:ext cx="6464808" cy="292608"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" b="1" dirty="0"><a:solidFill><a:srgbClr val="1B2A4A"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>二、本案辦理目標</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Text 10"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="658368" y="4032504"/><a:ext cx="6355080" cy="1325880"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>系統性介紹地方自治精神與代議制度運作,使民眾了解議員如何監督市政、為民服務。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>以第5屆議會為主軸,全面更新會史館六大展區展板、影音導覽與 AR 互動內容。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>以 LED 全彩大屏取代傳統投影,升級簡報室為現代化多功能簡報空間。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>產製中、英、日、台、韓五語簡介影片與雙語手冊,服務國內外訪賓與國際交流。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p><a:p><a:pPr marL="152400" indent="-152400"><a:lnSpc><a:spcPct val="122000"/></a:lnSpc><a:spcAft><a:spcPts val="500"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>完整紀錄第5屆議員就職典禮,為議會留存珍貴史料。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p