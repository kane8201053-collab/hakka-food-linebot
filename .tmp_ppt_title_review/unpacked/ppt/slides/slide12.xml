en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="16" name="Text 14"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="5340096"/><a:ext cx="6464808" cy="429768"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0" algn="l"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>對本會各項監督查核積極配合、提供所需資料並給予必要協助;經通知之缺失,於接獲通知 10 日內提出改善措施並據以執行,配合本會派員複查,直到確實改善為止。</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="Text 15"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="5916168"/><a:ext cx="6464808" cy="292608"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" b="1" dirty="0"><a:solidFill><a:srgbClr val="1B2A4A"/></a:solidFill><a:latin typeface="Microsoft JhengHei" pitchFamily="34" charset="0"/><a:ea typeface="Microsoft JhengHei" pitchFamily="34" charset="-122"/><a:cs typeface="Microsoft JhengHei" pitchFamily="34" charset="-120"/></a:rPr><a:t>五、本公司品質保證措施</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="18" name="Text 16"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="658368" y="6281928"/><a:ext cx="6355080" cy="1389888"/></a:x