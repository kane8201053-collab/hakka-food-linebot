gbClr val="60727A"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:rPr><a:t>末句後停 1 秒再進旁白</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="narration-18"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{588EFCC8-D945-49B6-96D1-7A800D7ADADB}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="4485753" y="2455627"/><a:ext cx="2484180" cy="7481094"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln w="0"><a:noFill/><a:prstDash val="solid"/></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="124000"/></a:lnSpc><a:buNone/><a:defRPr sz="1275"><a:solidFill><a:srgbClr val="142B34"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:defRPr></a:pPr><a:r><a:rPr sz="1274" b="1"><a:solidFill><a:srgbClr val="142B34"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:rPr><a:t>【議長建議原音】
</a:t></a:r><a:r><a:rPr sz="1274"><a:solidFill><a:srgbClr val="142B34"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:rPr><a:t>第五屆新北市議會，承接的是六十八席民意，更是市民對這座城市的期待。

我們會尊重不同聲音，善盡審議與監督責任，讓公共資源回應真正的需要；也會持續走進地方、傾聽市民，讓每一項承諾都有進度、每一個問題都有回應。

新北的未來，需要市民、議會與市府一起努力。看見彼此，我們就能一起把城市變得更好。</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:lnSpc><a:spcPct val="124000"/></a:lnSpc><a:buNone/><a:defRPr sz="1275"><a:solidFill><a:srgbClr val="142B34"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:defRPr></a:pPr><a:r><a:rPr sz="1274" b="1"><a:solidFill><a:srgbClr val="142B34"/></a:solidFill><a:latin typeface="PingFang TC"/><a:ea typeface="PingFang TC"/><a:cs typeface="PingFang TC"/></a:rPr><a:t>【旁白】
